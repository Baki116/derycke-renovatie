---
import { REGELS, TIMING, KLANTTYPE, DIENSTKEUZES } from '../lib/offerte-regels';
import { mb } from '../lib/fotos';

const fout = Astro.url.searchParams.get('fout');
---

<form
  class="of"
  action="/api/offerte/"
  method="post"
  enctype="multipart/form-data"
  novalidate
  data-offerte
  aria-describedby="of-uitleg"
>
  <p id="of-uitleg" class="of__uitleg zacht">Velden met <span aria-hidden="true">*</span><span class="sr-only">een sterretje</span> zijn verplicht. Uw aanvraag is gratis en vrijblijvend.</p>

  {
    fout && (
      <div class="of__melding of__melding--fout" role="alert">
        <p>
          <strong>Uw aanvraag is niet verzonden.</strong> {fout}
        </p>
      </div>
    )
  }

  <div class="of__foutlijst" role="alert" tabindex="-1" hidden data-foutlijst>
    <p><strong>Controleer de volgende velden:</strong></p>
    <ul></ul>
  </div>

  <fieldset class="of__groep">
    <legend><span class="of__nr" aria-hidden="true">01</span> Uw project</legend>

    <div class="veld">
      <span class="veld__label" id="klanttype-label">U bent <span aria-hidden="true">*</span></span>
      <div class="keuzes" role="radiogroup" aria-labelledby="klanttype-label" aria-required="true" id="klanttype" tabindex="-1">
        {
          KLANTTYPE.map((k, i) => (
            <label class="keuze">
              <input type="radio" name="klanttype" value={k} checked={i === 0} />
              <span>{k}</span>
            </label>
          ))
        }
      </div>
    </div>

    <div class="veld">
      <span class="veld__label" id="diensten-label">Welke werken? <span aria-hidden="true">*</span> <span class="veld__opt">(meerdere keuzes mogelijk)</span></span>
      <div class="keuzes" role="group" aria-labelledby="diensten-label" id="diensten" tabindex="-1" data-diensten-keuze>
        {
          DIENSTKEUZES.map((d) => (
            <label class="keuze keuze--vink">
              <input type="checkbox" name="diensten" value={d} />
              <span>{d}</span>
            </label>
          ))
        }
      </div>
      <p class="veld__fout" id="diensten-fout" hidden></p>
    </div>

    <div class="of__rij of__rij--gem">
      <div class="veld">
        <label for="gemeente">Gemeente van het project <span aria-hidden="true">*</span></label>
        <input id="gemeente" name="gemeente" type="text" autocomplete="address-level2" required maxlength="80" />
        <p class="veld__fout" id="gemeente-fout" hidden></p>
      </div>
      <div class="veld">
        <label for="postcode">Postcode <span aria-hidden="true">*</span></label>
        <input id="postcode" name="postcode" type="text" inputmode="numeric" autocomplete="postal-code" required maxlength="4" pattern="[1-9][0-9]{3}" />
        <p class="veld__fout" id="postcode-fout" hidden></p>
      </div>
    </div>

    <div class="veld">
      <label for="beschrijving">Beschrijving van uw project <span aria-hidden="true">*</span></label>
      <textarea
        id="beschrijving"
        name="beschrijving"
        rows="5"
        required
        minlength={REGELS.minBeschrijving}
        maxlength={REGELS.maxBeschrijving}
        aria-describedby="beschrijving-hulp"></textarea>
      <p class="veld__hulp" id="beschrijving-hulp">
        Bijvoorbeeld: welke ruimtes, de geschatte oppervlakte in m², de huidige toestand en wat u wilt bereiken.
      </p>
      <p class="veld__fout" id="beschrijving-fout" hidden></p>
    </div>

    <div class="veld">
      <span class="veld__label" id="timing-label">Gewenste timing <span class="veld__opt">(optioneel)</span></span>
      <div class="keuzes" role="radiogroup" aria-labelledby="timing-label">
        {
          TIMING.map((t) => (
            <label class="keuze">
              <input type="radio" name="timing" value={t} />
              <span>{t}</span>
            </label>
          ))
        }
      </div>
    </div>

    <div class="veld">
      <span class="veld__label" id="fotos-label">Foto's <span class="veld__opt">(optioneel, sterk aanbevolen)</span></span>
      <div class="upload" data-upload>
        <input
          id="fotos"
          name="fotos"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif"
          multiple
          class="upload__input"
          aria-labelledby="fotos-label fotos-knop"
          aria-describedby="fotos-hulp"
          data-fotos
        />
        <label for="fotos" class="upload__knop" id="fotos-knop">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h3l2-2.5h6L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
          Foto's toevoegen
        </label>
        <p class="veld__hulp" id="fotos-hulp">
          Tot {REGELS.maxFotos} foto's (JPG, PNG, WebP of HEIC, max. {mb(REGELS.maxBytesOrigineel)} per foto). Ze worden vóór verzending automatisch verkleind.
        </p>
        <ul class="upload__lijst" data-fotolijst aria-live="polite"></ul>
      </div>
      <p class="veld__fout" id="fotos-fout" hidden></p>
    </div>
  </fieldset>

  <fieldset class="of__groep">
    <legend><span class="of__nr" aria-hidden="true">02</span> Uw gegevens</legend>
    <div class="veld">
      <label for="naam">Naam <span aria-hidden="true">*</span></label>
      <input id="naam" name="naam" type="text" autocomplete="name" required maxlength="120" />
      <p class="veld__fout" id="naam-fout" hidden></p>
    </div>
    <div class="of__rij of__rij--2">
      <div class="veld">
        <label for="telefoon">Telefoonnummer <span aria-hidden="true">*</span></label>
        <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" inputmode="tel" required maxlength="30" />
        <p class="veld__fout" id="telefoon-fout" hidden></p>
      </div>
      <div class="veld">
        <label for="email">E-mailadres <span aria-hidden="true">*</span></label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="160" />
        <p class="veld__fout" id="email-fout" hidden></p>
      </div>
    </div>
  </fieldset>

  <!-- Antispam: dit veld blijft leeg bij echte bezoekers -->
  <div class="of__hp" aria-hidden="true">
    <label for="website">Laat dit veld leeg</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="gestart" value="" data-gestart />
  <input type="hidden" name="bron" value="formulier" />

  <div class="veld of__akkoord">
    <label class="vink">
      <input type="checkbox" name="akkoord" value="ja" id="akkoord" required />
      <span>
        Ik ga akkoord dat Derycke mijn gegevens en foto's gebruikt om mijn aanvraag te beantwoorden, zoals beschreven in de
        <a href="/privacyverklaring/">privacyverklaring</a>. <span aria-hidden="true">*</span>
      </span>
    </label>
    <p class="veld__fout" id="akkoord-fout" hidden></p>
  </div>

  <div class="of__verzend">
    <button type="submit" class="knop of__knop" data-verzendknop>
      <span data-knoptekst>Offerteaanvraag versturen</span>
      <span class="of__spinner" aria-hidden="true"></span>
    </button>
    <p class="of__status" role="status" aria-live="polite" data-status></p>
  </div>

  <div class="of__melding of__melding--fout" role="alert" tabindex="-1" hidden data-serverfout></div>
</form>

<script>
  import { REGELS, DIENSTKEUZES, isGeldigEmail, isGeldigTelefoon, isGeldigePostcode } from '../lib/offerte-regels';
  import { voegFotosToe, voorbeeldUrl, mb } from '../lib/fotos';

  const form = document.querySelector<HTMLFormElement>('[data-offerte]');
  if (form) init(form);

  function init(form: HTMLFormElement) {
    const gestart = form.querySelector<HTMLInputElement>('[data-gestart]')!;
    gestart.value = String(Date.now());

    // Dienst en klanttype voorselecteren via ?dienst= en ?klant=
    const params = new URLSearchParams(location.search);
    const dienstParam = params.get('dienst') ?? params.get('type');
    if (dienstParam) {
      const passend = DIENSTKEUZES.find((d) => d.toLowerCase() === dienstParam.toLowerCase());
      const vak = passend && form.querySelector<HTMLInputElement>(`input[name="diensten"][value="${passend}"]`);
      if (vak) vak.checked = true;
    }
    const klant = params.get('klant');
    if (klant) {
      const waarde = klant === 'vastgoed' ? 'Vastgoedkantoor of projectontwikkelaar' : klant === 'bedrijf' ? 'Bedrijf' : null;
      const r = waarde && form.querySelector<HTMLInputElement>(`input[name="klanttype"][value="${waarde}"]`);
      if (r) r.checked = true;
    }

    // ── Foto's ─────────────────────────────────────────
    const fotoInput = form.querySelector<HTMLInputElement>('[data-fotos]')!;
    const fotoLijst = form.querySelector<HTMLUListElement>('[data-fotolijst]')!;
    let fotos: File[] = [];
    const urls = new Map<File, string | null>();

    fotoInput.addEventListener('change', async () => {
      const nieuw = [...(fotoInput.files ?? [])];
      fotoInput.value = '';
      zetFout('fotos', '');
      const r = await voegFotosToe(fotos, nieuw);
      fotos = r.fotos;
      if (r.fout) zetFout('fotos', r.fout);
      tekenLijst();
    });

    function tekenLijst() {
      fotoLijst.innerHTML = '';
      fotos.forEach((f, i) => {
        if (!urls.has(f)) urls.set(f, voorbeeldUrl(f));
        const li = document.createElement('li');
        const url = urls.get(f);
        if (url) {
          const img = document.createElement('img');
          img.src = url;
          img.alt = '';
          img.width = 56;
          img.height = 56;
          li.append(img);
        } else {
          const ph = document.createElement('span');
          ph.className = 'upload__ph';
          ph.textContent = 'HEIC';
          li.append(ph);
        }
        const naam = document.createElement('span');
        naam.className = 'upload__naam';
        naam.textContent = `${f.name} (${mb(f.size)})`;
        const weg = document.createElement('button');
        weg.type = 'button';
        weg.textContent = 'Verwijderen';
        weg.setAttribute('aria-label', `${f.name} verwijderen`);
        weg.addEventListener('click', () => {
          const u = urls.get(f);
          if (u) URL.revokeObjectURL(u);
          urls.delete(f);
          fotos.splice(i, 1);
          zetFout('fotos', '');
          tekenLijst();
          fotoInput.focus();
        });
        li.append(naam, weg);
        fotoLijst.append(li);
      });
    }

    // ── Validatie ──────────────────────────────────────
    const waarde = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '';
    const gekozenDiensten = () => [...form.querySelectorAll<HTMLInputElement>('input[name="diensten"]:checked')];
    const velden: Record<string, () => string> = {
      diensten: () => (gekozenDiensten().length ? '' : 'Kies minstens één soort werken.'),
      gemeente: () => (waarde('gemeente').trim().length < 2 ? 'Vul de gemeente van het project in.' : ''),
      postcode: () => (!isGeldigePostcode(waarde('postcode')) ? 'Vul een geldige Belgische postcode in, bijvoorbeeld 9000.' : ''),
      beschrijving: () =>
        waarde('beschrijving').trim().length < REGELS.minBeschrijving
          ? `Beschrijf uw project in minstens ${REGELS.minBeschrijving} tekens.`
          : '',
      naam: () => (waarde('naam').trim().length < 2 ? 'Vul uw naam in.' : ''),
      telefoon: () => (!isGeldigTelefoon(waarde('telefoon')) ? 'Vul een geldig telefoonnummer in, bijvoorbeeld 0470 12 34 56.' : ''),
      email: () =>
        !waarde('email').trim()
          ? 'Vul uw e-mailadres in.'
          : !isGeldigEmail(waarde('email'))
            ? 'Vul een geldig e-mailadres in, bijvoorbeeld naam@voorbeeld.be.'
            : '',
      akkoord: () => ((form.elements.namedItem('akkoord') as HTMLInputElement).checked ? '' : 'Vink het akkoord aan zodat we uw aanvraag mogen beantwoorden.'),
    };
    const labels: Record<string, string> = {
      diensten: 'Welke werken',
      gemeente: 'Gemeente',
      postcode: 'Postcode',
      beschrijving: 'Beschrijving',
      naam: 'Naam',
      telefoon: 'Telefoonnummer',
      email: 'E-mailadres',
      akkoord: 'Akkoord',
      fotos: "Foto's",
    };

    function zetFout(naam: string, tekst: string) {
      const el = form.querySelector<HTMLElement>(`#${naam}-fout`);
      const input = form.querySelector<HTMLElement>(`#${naam}`);
      if (el) {
        el.textContent = tekst;
        el.hidden = !tekst;
      }
      if (input) {
        if (tekst) {
          input.setAttribute('aria-invalid', 'true');
          const besch = new Set((input.getAttribute('aria-describedby') ?? '').split(' ').filter(Boolean));
          besch.add(`${naam}-fout`);
          input.setAttribute('aria-describedby', [...besch].join(' '));
        } else {
          input.removeAttribute('aria-invalid');
        }
      }
    }

    function controleer(naam: string) {
      const fout = velden[naam]?.() ?? '';
      zetFout(naam, fout);
      return fout;
    }

    Object.keys(velden).forEach((naam) => {
      const el = form.querySelector<HTMLInputElement>(`#${naam}`);
      if (!el || naam === 'diensten') return;
      el.addEventListener('blur', () => {
        if (el.value || el.getAttribute('aria-invalid')) controleer(naam);
      });
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid')) controleer(naam);
      });
    });
    form.querySelector('[data-diensten-keuze]')?.addEventListener('change', () => {
      if (form.querySelector('#diensten')?.getAttribute('aria-invalid')) controleer('diensten');
    });
    form.querySelector('#akkoord')?.addEventListener('change', () => controleer('akkoord'));

    // ── Verzenden ──────────────────────────────────────
    const foutlijst = form.querySelector<HTMLElement>('[data-foutlijst]')!;
    const knop = form.querySelector<HTMLButtonElement>('[data-verzendknop]')!;
    const knopTekst = form.querySelector<HTMLElement>('[data-knoptekst]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const serverFout = form.querySelector<HTMLElement>('[data-serverfout]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      serverFout.hidden = true;

      const fouten = Object.keys(velden)
        .map((n) => [n, controleer(n)] as const)
        .filter(([, f]) => f);
      const totaal = fotos.reduce((s, f) => s + f.size, 0);
      if (totaal > REGELS.maxBytesTotaal) fouten.push(['fotos', `De foto's zijn samen te groot (max. ${mb(REGELS.maxBytesTotaal)}).`]);

      if (fouten.length) {
        const ul = foutlijst.querySelector('ul')!;
        ul.innerHTML = '';
        fouten.forEach(([n, f]) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${n}`;
          a.textContent = `${labels[n]}: ${f}`;
          a.addEventListener('click', (ev) => {
            ev.preventDefault();
            const doel = form.querySelector<HTMLElement>(`#${n}`);
            const focusbaar = doel?.matches('input, textarea') ? doel : doel?.querySelector<HTMLElement>('input');
            focusbaar?.focus();
          });
          li.append(a);
          ul.append(li);
        });
        foutlijst.hidden = false;
        foutlijst.focus();
        return;
      }
      foutlijst.hidden = true;

      const data = new FormData(form);
      data.delete('fotos');
      fotos.forEach((f) => data.append('fotos', f, f.name));

      knop.disabled = true;
      knop.classList.add('is-bezig');
      knopTekst.textContent = 'Bezig met verzenden…';
      status.textContent = 'Uw aanvraag wordt verzonden.';

      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => null);
        if (!res.ok || !json?.ok) {
          throw new Error(json?.fout || 'Er ging iets mis bij het verzenden. Probeer het later opnieuw.');
        }
        status.textContent = 'Uw aanvraag is verzonden.';
        location.href = `/contact/bedankt/?fotos=${fotos.length}`;
      } catch (err) {
        const bericht =
          err instanceof TypeError
            ? 'Het formulier kon de server niet bereiken. Controleer uw internetverbinding of probeer het later opnieuw.'
            : (err as Error).message;
        serverFout.innerHTML = '';
        const p = document.createElement('p');
        const s = document.createElement('strong');
        s.textContent = 'Uw aanvraag is niet verzonden. ';
        p.append(s, document.createTextNode(bericht));
        serverFout.append(p);
        serverFout.hidden = false;
        status.textContent = '';
        serverFout.focus();
        knop.disabled = false;
        knop.classList.remove('is-bezig');
        knopTekst.textContent = 'Offerteaanvraag versturen';
      }
    });
  }
</script>

<style>
  .of {
    display: grid;
    gap: 2.25rem;
  }
  .of__uitleg {
    margin: 0;
    font-size: var(--fs-0);
  }
  .of__groep {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }
  legend {
    padding: 0;
    margin-bottom: 1.25rem;
    font-size: var(--fs-3);
    font-weight: 500;
    font-stretch: var(--breed);
    width: 100%;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--steen-licht);
  }
  .of__rij {
    display: grid;
    gap: 1.25rem;
  }
  .of__rij--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .veld {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    min-width: 0;
  }
  .veld label,
  .veld__label {
    font-size: var(--fs-1);
    font-weight: 520;
  }
  .veld__opt {
    font-weight: 400;
    color: var(--steen-donker);
  }
  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 1rem; /* voorkomt inzoomen op iOS */
    color: var(--antraciet);
    background: var(--wit);
    border: 1px solid var(--rand-veld);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  textarea {
    resize: vertical;
    min-height: 9rem;
    line-height: 1.5;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: var(--antraciet);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--antraciet);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brons) 35%, transparent);
  }
  [aria-invalid='true'] {
    border-color: var(--fout) !important;
  }
  .select {
    position: relative;
  }
  .select::after {
    content: '';
    position: absolute;
    right: 1rem;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  select {
    appearance: none;
    padding-right: 2.5rem;
    cursor: pointer;
  }
  .veld__hulp {
    margin: 0;
    font-size: var(--fs-0);
    color: var(--steen-donker);
  }
  .veld__fout {
    margin: 0;
    font-size: var(--fs-0);
    font-weight: 520;
    color: var(--fout);
  }
  .keuzes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .keuze {
    position: relative;
    font-weight: 400 !important;
  }
  .keuze input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .keuze span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--rand-veld);
    border-radius: 99px;
    background: var(--wit);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .keuze input:checked + span {
    background: var(--antraciet);
    border-color: var(--antraciet);
    color: var(--kalk);
  }
  .keuze input:focus-visible + span {
    outline: 2px solid var(--brons);
    outline-offset: 3px;
  }
  .upload {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: 1.25rem;
    border: 1px dashed var(--rand-veld);
    border-radius: var(--radius);
    background: var(--wit);
  }
  .upload__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }
  .upload__knop {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--antraciet);
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 540 !important;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .upload__knop:hover {
    background: var(--antraciet);
    color: var(--kalk);
  }
  .upload__input:focus-visible + .upload__knop {
    outline: 2px solid var(--brons);
    outline-offset: 3px;
  }
  .upload__lijst {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    font-size: var(--fs-1);
  }
  .upload__lijst :global(li) {
    display: flex;
    justify-content: space-between;
    align-items: center;
