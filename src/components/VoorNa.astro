---
/**
 * Voor/na-schuifregelaar. Toegankelijk met muis, vinger en toetsenbord (pijltjestoetsen).
 * Beelden komen uit src/data/beelden.ts (voorNa).
 */
import { Picture } from 'astro:assets';
import type { Beeld } from '../data/beelden';

interface Props {
  voor: Beeld;
  na: Beeld;
  titel: string;
  ratio?: string;
  sizes?: string;
}
const { voor, na, titel, ratio = '3 / 2', sizes = '(min-width: 1100px) 1000px, 100vw' } = Astro.props;
const inspiratie = voor.inspiratie || na.inspiratie;
const id = `vn-${titel.toLowerCase().replace(/[^a-z]+/g, '-')}`;
const breedtes = (w: number) => [640, 960, 1400, 1800].filter((x) => x <= w);
---

<figure class="vn" style={`aspect-ratio:${ratio}`} data-voorna aria-labelledby={`${id}-bijschrift`}>
  <Picture src={na.src} alt={na.alt} widths={breedtes(na.src.width)} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="lazy" class="vn__na" />
  <div class="vn__voor" aria-hidden="false">
    <Picture src={voor.src} alt={voor.alt} widths={breedtes(voor.src.width)} sizes={sizes} formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="lazy" />
  </div>
  <span class="vn__tag vn__tag--voor" aria-hidden="true">Voor</span>
  <span class="vn__tag vn__tag--na" aria-hidden="true">Na</span>
  <div class="vn__greep" aria-hidden="true">
    <span class="vn__knop">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5" /></svg>
    </span>
  </div>
  <input
    class="vn__bereik"
    type="range"
    min="0"
    max="100"
    value="50"
    step="1"
    aria-label={`${titel}: schuif om de situatie voor en na te vergelijken`}
    aria-valuetext="50% voor, 50% na"
    data-bereik
  />
  <figcaption id={`${id}-bijschrift`} class="sr-only">{titel}: voor en na de renovatie</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-voorna]').forEach((vn) => {
    const bereik = vn.querySelector<HTMLInputElement>('[data-bereik]')!;
    const zet = (v: number) => {
      const w = Math.max(0, Math.min(100, v));
      vn.style.setProperty('--pos', `${w}%`);
      bereik.value = String(Math.round(w));
      bereik.setAttribute('aria-valuetext', `${Math.round(w)}% voor, ${100 - Math.round(w)}% na`);
    };
    bereik.addEventListener('input', () => zet(Number(bereik.value)));
    let slepen = false;
    const vanPunt = (e: PointerEvent) => {
      const r = vn.getBoundingClientRect();
      zet(((e.clientX - r.left) / r.width) * 100);
    };
    vn.addEventListener('pointerdown', (e) => {
      slepen = true;
      vn.setPointerCapture(e.pointerId);
      vn.classList.add('is-slepen');
      vanPunt(e);
    });
    vn.addEventListener('pointermove', (e) => slepen && vanPunt(e));
    const stop = () => {
      slepen = false;
      vn.classList.remove('is-slepen');
    };
    vn.addEventListener('pointerup', stop);
    vn.addEventListener('pointercancel', stop);

    // Eenmalige hint wanneer de regelaar in beeld komt
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          vn.classList.add('is-hint');
          setTimeout(() => vn.classList.remove('is-hint'), 1800);
        },
        { threshold: 0.6 },
      );
      io.observe(vn);
    }
  });
</script>

<style>
  .vn {
    --pos: 50%;
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--steen-licht);
    touch-action: pan-y;
    user-select: none;
    cursor: ew-resize;
    border-radius: 2px;
  }
  .vn :global(picture),
  .vn :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vn__voor {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .vn.is-hint .vn__voor,
  .vn.is-hint .vn__greep {
    animation: vn-hint 1.8s var(--ease);
  }
  @keyframes vn-hint {
    35% {
      --pos: 38%;
    }
    70% {
      --pos: 60%;
    }
  }
  .vn__greep {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 1px;
    background: #f8f7f4;
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.15);
    transform: translateX(-0.5px);
    pointer-events: none;
  }
  .vn__knop {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3.25rem;
    height: 3.25rem;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--wit);
    color: var(--antraciet);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s var(--ease);
  }
  .vn.is-slepen .vn__knop {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .vn__knop svg {
    width: 1.35rem;
  }
  .vn__bereik {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    pointer-events: none;
  }
  .vn:has(.vn__bereik:focus-visible) {
    outline: 2px solid var(--brons);
    outline-offset: 3px;
  }
  .vn__tag {
    position: absolute;
    top: 1rem;
    padding: 0.4rem 0.7rem;
    background: rgba(36, 39, 43, 0.82);
    color: #f3f2ee;
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 2px;
    pointer-events: none;
  }
  .vn__tag--voor {
    left: 1rem;
  }
  .vn__tag--na {
    right: 1rem;
  }
  .vn__insp {
    left: auto;
    right: 0.75rem;
  }
</style>
