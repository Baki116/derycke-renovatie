---
import Foto from './Foto.astro';
import Pijl from './Pijl.astro';
import standaard from '../assets/beelden/schilderwerk-lijn.jpg';
import type { ImageMetadata } from 'astro';
import { site, telLink } from '../config/site';

interface Props {
  titel?: string;
  tekst?: string;
  beeld?: { src: ImageMetadata; alt: string; inspiratie?: boolean };
  /** Vooraf geselecteerde dienst in het formulier */
  dienst?: string;
  /** Vooraf geselecteerd klanttype: 'bedrijf' of 'vastgoed' */
  klant?: string;
}
const {
  beeld = { src: standaard, alt: 'Strakke verflijn tussen een warmgrijze muur en een witte plafondlijst' },
  dienst,
  klant,
  titel = 'Vertel ons over uw project.',
  tekst = 'Beschrijf kort wat u wilt laten uitvoeren en voeg gerust enkele foto’s toe. We nemen contact met u op om uw aanvraag te bespreken.',
} = Astro.props;
---

<section class="slot" aria-labelledby="slot-titel">
  <div class="wrap slot__grid">
    <div class="slot__tekst" data-reveal>
      <h2 id="slot-titel">{titel}</h2>
      <p class="lead zacht">{tekst}</p>
      <div class="slot__acties">
        <a href={`/contact/${dienst ? `?dienst=${encodeURIComponent(dienst)}` : klant ? `?klant=${klant}` : ''}#offerte`} class="knop">Vraag uw vrijblijvende offerte aan <Pijl /></a>
        {
          telLink && (
            <a class="tekstlink" href={telLink}>
              Of bel {site.contact.telefoonWeergave}
            </a>
          )
        }
        <button type="button" class="tekstlink slot__assistent" data-assistent-open aria-controls="assistent" aria-haspopup="dialog">Of vraag het de assistent</button>
      </div>
    </div>
    <Foto
      src={beeld.src}
      alt={beeld.alt}
      sizes="(min-width: 900px) 40vw, 100vw"
      widths={[480, 800, 1200]}
      class="slot__beeld"
      inspiratie={beeld.inspiratie}
    />
  </div>
</section>

<style>
  .slot__assistent {
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    padding: 0 0 0.15rem;
    font: inherit;
    font-weight: 540;
    color: inherit;
    cursor: pointer;
  }
  .slot {
    background: var(--wit);
    border-top: 1px solid var(--steen-licht);
  }
  .slot__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem clamp(2rem, 6vw, 7rem);
    align-items: center;
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
  }
  .slot h2 {
    font-size: var(--fs-5);
    margin-bottom: 1.5rem;
    max-width: 14ch;
  }
  .slot__acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.25rem;
  }
  :global(.slot__beeld) {
    aspect-ratio: 4 / 5;
    max-height: 34rem;
  }
  @media (max-width: 900px) {
    .slot__grid {
      grid-template-columns: 1fr;
    }
    :global(.slot__beeld) {
      aspect-ratio: 16 / 10;
      order: -1;
    }
  }
</style>
