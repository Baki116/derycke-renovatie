---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { diensten } from '../data/diensten';
import ogBron from '../assets/beelden/hero-woonkamer.jpg';

interface Props {
  titel: string;
  omschrijving: string;
  /** Extra JSON-LD voor deze pagina (bv. BreadcrumbList of FAQPage). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { titel, omschrijving, schema = [], noindex = false } = Astro.props;

const volledigeTitel = titel.includes('Derycke') ? titel : `${titel} | Derycke Renovatie & Schilderwerken`;
const canoniek = new URL(Astro.url.pathname, Astro.site);
const robots = !site.indexeerbaar || noindex ? 'noindex, nofollow' : 'index, follow';

const og = await getImage({ src: ogBron, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogUrl = new URL(og.src, Astro.site).href;

// Gestructureerde data: enkel bevestigde gegevens.
const bedrijf: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': new URL('/#bedrijf', Astro.site).href,
  name: site.naam,
  slogan: site.slogan,
  url: new URL('/', Astro.site).href,
  areaServed: { '@type': 'AdministrativeArea', name: 'Vlaanderen' },
  knowsAbout: diensten.map((d) => d.titel),
};
if (site.contact.telefoon) bedrijf.telephone = site.contact.telefoon;
if (site.contact.email) bedrijf.email = site.contact.email;
if (site.adres.straat && site.adres.postcode && site.adres.gemeente) {
  bedrijf.address = {
    '@type': 'PostalAddress',
    streetAddress: site.adres.straat,
    postalCode: site.adres.postcode,
    addressLocality: site.adres.gemeente,
    addressCountry: 'BE',
  };
}
if (site.onderneming.ondernemingsnummer) bedrijf.vatID = site.onderneming.ondernemingsnummer;

const alleSchema = [bedrijf, ...schema];
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{volledigeTitel}</title>
    <meta name="description" content={omschrijving} />
    <link rel="canonical" href={canoniek} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#24272b" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content={site.naam} />
    <meta property="og:title" content={volledigeTitel} />
    <meta property="og:description" content={omschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(alleSchema.length === 1 ? alleSchema[0] : alleSchema)} />
  </head>
  <body>
    <a class="skiplink" href="#inhoud">Naar de inhoud</a>
    {
      site.demo && (
        <p class="voorbeeldband">
          Voorbeeldversie: een eerste ontwerp om de richting te tonen. De definitieve website wordt afgewerkt met uw eigen
          foto's, logo en gegevens.
        </p>
      )
    }
    <Header />
    <main id="inhoud" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
